<resources>
    <style name="Theme.Hutao" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/surface</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
